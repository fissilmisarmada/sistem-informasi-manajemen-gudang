      "html": "<label class=\"ds-label\">Nama Barang</label><input class=\"ds-input\" placeholder=\"Cari SKU atau nama barang\" />",
      "css": ".ds-label{display:block;font-family:'Instrument Sans',ui-sans-serif,system-ui,sans-serif;font-size:11px;font-weight:700;letter-spacing:.06em;color:#475569;margin-bottom:6px;text-transform:uppercase}.ds-input{width:100%;padding:11px 14px;border:1px solid #E8EAF0;border-radius:14px;font-family:'Instrument Sans',ui-sans-serif,system-ui,sans-serif;font-size:14px;background:#FBFBFD;color:#0F172A;transition:border-color .16s,box-shadow .16s,background .16s}.ds-input::placeholder{color:#94A3B8}.ds-input:focus{outline:none;background:#fff;border-color:#0F172A;box-shadow:0 0 0 3px rgba(15,23,42,.06)}"
