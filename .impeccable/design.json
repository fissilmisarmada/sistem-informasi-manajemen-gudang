      "css": ".ds-card{background:#fff;border:1px solid #EDEEF2;border-radius:20px;box-shadow:0 6px 24px rgba(15,23,42,.06),0 1px 2px rgba(15,23,42,.04);padding:16px;transition:box-shadow .22s,border-color .22s,transform .22s}.ds-card:hover{box-shadow:0 10px 28px rgba(15,23,42,.08),0 2px 6px rgba(15,23,42,.05);transform:translateY(-1px)}.ds-card-head{font-family:'Instrument Sans',ui-sans-serif,system-ui,sans-serif;font-size:11px;font-weight:800;letter-spacing:.10em;text-transform:uppercase;color:#475569;margin-bottom:12px}.ds-card-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid #F1F5F9;font-size:12px;color:#475569}.ds-card-row strong{color:#0F172A;font-weight:700}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "badge-green",
      "description": "Pill status — green/red/blue/yellow, bukan filter chip.",
      "html": "<span class=\"ds-badge ds-badge--green\">Masuk</span> <span class=\"ds-badge ds-badge--red\">Menipis</span> <span class=\"ds-badge ds-badge--blue\">Rak A-12</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;padding:3px 9px;border-radius:999px;font-family:'Instrument Sans',ui-sans-serif,system-ui,sans-serif;font-size:11px;font-weight:700;border:1px solid transparent}.ds-badge--green{background:#ECFDF5;color:#065F46;border-color:#A7F3D0}.ds-badge--red{background:#FEF2F2;color:#991B1B;border-color:#FECACA}.ds-badge--blue{background:#EFF6FF;color:#1E3A5F;border-color:#DBEAFE}"
