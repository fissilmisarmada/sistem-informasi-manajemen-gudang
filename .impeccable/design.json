      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:38px;padding:0 16px;border-radius:12px;font-family:'Instrument Sans',ui-sans-serif,system-ui,sans-serif;font-size:13px;font-weight:700;letter-spacing:-0.01em;border:1px solid #CBD5E1;background:#fff;color:#0F172A;cursor:pointer;transition:border-color .16s,transform .14s,box-shadow .16s}.ds-btn-ghost:hover{border-color:#0F172A;transform:translateY(-1px);box-shadow:0 6px 24px rgba(15,23,42,.06),0 1px 2px rgba(15,23,42,.04)}.ds-btn-ghost:focus-visible{outline:2px solid #0F2540;outline-offset:2px}"
