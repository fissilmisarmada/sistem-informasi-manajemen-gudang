      "css": ".ds-btn-amber{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:38px;padding:0 16px;border-radius:12px;font-family:'Instrument Sans',ui-sans-serif,system-ui,sans-serif;font-size:13px;font-weight:800;letter-spacing:-0.01em;border:1px solid #E6C200;background:#F7D60A;color:#0F172A;cursor:pointer;box-shadow:0 4px 16px rgba(247,214,10,.14);transition:filter .16s,transform .14s}.ds-btn-amber:hover{filter:brightness(.98);transform:translateY(-1px)}.ds-btn-amber:focus-visible{outline:2px solid #0F2540;outline-offset:2px}"
